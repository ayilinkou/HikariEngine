#include "ShaderTypes.h"
#include "registers.slangh"

// Bind group N is register space N, and the index is the binding. The four
// -fvk-*-shift flags on the SPIR-V compile are what make Slang derive the
// Vulkan set and binding from the register rather than needing a second
// annotation (plan D29).
ConstantBuffer<GlobalBuffer> globalBuffer : register(b0, space0);

/**
 * True when clip-space Y points down the image, as Vulkan's does and D3D12's does
 * not. A pass that maps image rows to clip space without drawing geometry through
 * the projection needs this, since only the rasteriser applies the flip for it.
 * It is read from the projection rather than passed as a flag of its own, because
 * the renderer negates the projection's Y scale for exactly these backends, and a
 * second copy of that fact could disagree with the first.
 */
bool ClipSpaceYPointsDown()
{
	return globalBuffer.Camera.Proj[1][1] < 0.f;
}

// Inverse-square law
float CalcAttenuation(float3 FragPos, float3 LightPos)
{
	float Distance = distance(FragPos, LightPos);
	return 1.f / (Distance * Distance);
}
