{
	"version": 6,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
			}
		},
		{
			"name": "linux-base",
			"inherits": "base",
			"hidden": true,
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x64-linux"
			}
		},
		{
			"name": "ninja-debug-linux",
			"inherits": "linux-base",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "ninja-asan-linux",
			"inherits": "ninja-debug-linux",
			"description": "Debug config for Ninja on Linux using Address Sanitizer and Undefined Behaviour Sanitizer",
			"cacheVariables": {
				"ENABLE_SANITIZERS": "ON",
				"VCPKG_TARGET_TRIPLET": "x64-linux-asan",
				"VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets"
			}
		},
		{
			"name": "ninja-release-linux",
			"inherits": "linux-base",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "windows-base",
			"inherits": "base",
			"hidden": true,
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x64-windows"
			}
		},
		{
			"name": "msvc",
			"inherits": "windows-base",
			"generator": "Visual Studio 17 2022"
		},
		{
			"name": "macos-base",
			"inherits": "base",
			"hidden": true,
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "arm64-osx",
				"CMAKE_MAKE_PROGRAM": "/opt/homebrew/bin/ninja",
				"CMAKE_C_COMPILER": "/usr/bin/clang",
				"CMAKE_CXX_COMPILER": "/usr/bin/clang++"
			}
		},
		{
			"name": "ninja-debug-macos",
			"inherits": "macos-base",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "ninja-release-macos",
			"inherits": "macos-base",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	],
	"buildPresets": [
		{
			"name": "ninja-debug-linux",
			"configurePreset": "ninja-debug-linux"
		},
		{
			"name": "ninja-asan-linux",
			"description": "Debug config for Ninja on Linux using Address Sanitizer and Undefined Behaviour Sanitizer",
			"configurePreset": "ninja-asan-linux"
		},
		{
			"name": "ninja-release-linux",
			"configurePreset": "ninja-release-linux"
		},
		{
			"name": "ninja-debug-macos",
			"configurePreset": "ninja-debug-macos"
		},
		{
			"name": "ninja-release-macos",
			"configurePreset": "ninja-release-macos"
		}
	],
	"workflowPresets": [
		{
			"name": "ninja-debug-linux",
			"steps": [
				{
					"type": "configure",
					"name": "ninja-debug-linux"
				},
				{
					"type": "build",
					"name": "ninja-debug-linux"
				}
			]
		},
		{
			"name": "ninja-asan-linux",
			"description": "Debug config for Ninja on Linux using Address Sanitizer and Undefined Behaviour Sanitizer",
			"steps": [
				{
					"type": "configure",
					"name": "ninja-asan-linux"
				},
				{
					"type": "build",
					"name": "ninja-asan-linux"
				}
			]
		},
		{
			"name": "ninja-release-linux",
			"steps": [
				{
					"type": "configure",
					"name": "ninja-release-linux"
				},
				{
					"type": "build",
					"name": "ninja-release-linux"
				}
			]
		},
		{
			"name": "ninja-debug-macos",
			"steps": [
				{
					"type": "configure",
					"name": "ninja-debug-macos"
				},
				{
					"type": "build",
					"name": "ninja-debug-macos"
				}
			]
		},
		{
			"name": "ninja-release-macos",
			"steps": [
				{
					"type": "configure",
					"name": "ninja-release-macos"
				},
				{
					"type": "build",
					"name": "ninja-release-macos"
				}
			]
		},
		{
			"name": "generate-sln",
			"steps": [
				{
					"type": "configure",
					"name": "msvc"
				}
			]
		}
	]
}
