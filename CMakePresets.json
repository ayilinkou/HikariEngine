                }
            ]
        },
        {
            "name": "ninja-asan-linux",
            "description": "Debug config for Ninja on Linux using Address Sanitizer and Undefined Behaviour Sanitizer",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-asan-linux"
                },
                {
                    "type": "build",
                    "name": "ninja-asan-linux"
                }
            ]
        },
        {
            "name": "ninja-release-linux",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-release-linux"
                },
                {
                    "type": "build",
                    "name": "ninja-release-linux"
                }
            ]
        },
        {
            "name": "ninja-debug-windows",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-debug-windows"
                },
                {
                    "type": "build",
                    "name": "ninja-debug-windows"
                }
            ]
        },
        {
            "name": "ninja-asan-windows",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-asan-windows"
                },
                {
                    "type": "build",
                    "name": "ninja-asan-windows"
                }
            ]
        },
        {
            "name": "ninja-release-windows",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-release-windows"
                },
                {
                    "type": "build",
                    "name": "ninja-release-windows"
                }
            ]
        },
        {
            "name": "ninja-debug-macos",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-debug-macos"
                },
                {
                    "type": "build",
                    "name": "ninja-debug-macos"
                }
            ]
        },
        {
            "name": "ninja-asan-macos",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-asan-macos"
                },
                {
                    "type": "build",
                    "name": "ninja-asan-macos"
                }
            ]
        },
        {
            "name": "ninja-release-macos",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-release-macos"
                },
                {
                    "type": "build",
                    "name": "ninja-release-macos"
                }
            ]
        },
        {
            "name": "generate-sln",
            "steps": [
                {
                    "type": "configure",
                    "name": "msvc"
                }
            ]
        }
    ]
}
