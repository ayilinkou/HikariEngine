{
  "name": "hikari-engine",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ]
    },
    "glm",
    "stb",
    "assimp",
    {
      "name": "imgui",
      "features": [
        "vulkan-binding",
        "sdl3-binding"
      ]
    },
    "pugixml",
    "vulkan-memory-allocator",
    {
      "name": "vulkan-loader",
      "features": [
        "wayland",
        "xcb",
        "xlib"
      ],
      "platform": "linux"
    },
    "vulkan-validationlayers",
    {
      "name": "directx-headers",
      "platform": "windows"
    },
    {
      "name": "directx12-agility",
      "platform": "windows"
    },
    {
      "name": "d3d12-memory-allocator",
      "platform": "windows"
    },
    {
      "name": "directx-warp",
      "platform": "windows"
    },
    {
      "name": "shader-slang",
      "host": true
    },
    {
      "name": "spirv-tools",
      "features": [
        "tools"
      ],
      "host": true
    },
    {
      "name": "directx-dxc",
      "host": true
    },
    "catch2",
    "nlohmann-json"
  ]
}
